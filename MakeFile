BINARY ?= gochecksec
VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
COMMIT ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo none)
BUILD_DATE ?= $(shell date -u +%Y-%m-%dT%H:%M:%SZ)

RELEASE_LDFLAGS = -s -w -X main.version=$(VERSION) -X main.commit=$(COMMIT) -X main.date=$(BUILD_DATE)
DEBUG_LDFLAGS = -X main.version=$(VERSION) -X main.commit=$(COMMIT) -X main.date=$(BUILD_DATE)

.PHONY: all build build-x86_64 build-arm64 test clean debug-amd64 debug-arm64 clean-debug

all: test build

build: build-x86_64 build-arm64

build-x86_64:
	GOOS=linux GOARCH=amd64 go build -ldflags "$(RELEASE_LDFLAGS)" -o $(BINARY)_x86_64 .

build-arm64:
	GOOS=linux GOARCH=arm64 go build -ldflags "$(RELEASE_LDFLAGS)" -o $(BINARY)_arm64 .

test:
	go test -v ./...

clean:
	@rm -f $(BINARY)_x86_64 $(BINARY)_arm64

debug-amd64:
	@echo "Building Debug AMD64 Binary"
	GOOS=linux GOARCH=amd64 go build -gcflags "all=-N -l" -ldflags "$(DEBUG_LDFLAGS)" -o $(BINARY)-debug-amd64 .

debug-arm64:
	@echo "Building Debug ARM64 Binary"
	GOOS=linux GOARCH=arm64 go build -gcflags "all=-N -l" -ldflags "$(DEBUG_LDFLAGS)" -o $(BINARY)-debug-arm64 .

# Clean Debug Binary
clean-debug:
	@echo "Cleaning Debug Binaries"
	@rm -f $(BINARY)-debug-amd64
	@rm -f $(BINARY)-debug-arm64
